<!DOCTYPE html>
<html lang="lo">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>phupha game store - ເວັບເຕີມເກມ ແລະ ຕື່ມເງິນອອນໄລນ໌</title>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script type="text/javascript">
        (function() {
            emailjs.init("2Rr4eiGTv6nzu1xT0");
        })();
    </script>

    <style>
        * { box-sizing: border-box; font-family: sans-serif; margin: 0; padding: 0; }
        body { background-color: #120303; color: #fff; padding: 20px; text-align: center; }
        h1 { color: #ff3838; margin-bottom: 15px; text-shadow: 0 0 10px #ff3838; font-size: 28px; }
        
        /* ຕີມສີແດງ - ຮູບແບບຮ້ານ phupha game store */
        .top-banners { display: flex; justify-content: center; gap: 15px; margin-bottom: 25px; flex-wrap: wrap; }
        .top-banners img { width: 45%; max-width: 350px; height: auto; border-radius: 12px; border: 2px solid #ff3838; box-shadow: 0 5px 15px rgba(255, 56, 56, 0.3); }
        @media(max-width: 768px) {
            .top-banners img { width: 100%; }
        }

        .auth-bar { background: #220808; max-width: 450px; margin: 0 auto 20px auto; padding: 20px; border-radius: 12px; border: 1px solid #591c1c; }
        .user-info { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .btn-auth { background: #ff3838; color: #fff; border: none; padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; font-size: 15px; }
        .btn-logout { background: #cc0000; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .btn-topup-money { background: #ff6b6b; color: #120303; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .btn-topup-card-bar { background: #ff6b6b; color: #120303; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .btn-admin-panel { background: #ff9f43; color: #120303; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 8px; display: none; }

        .auth-tabs { display: flex; gap: 10px; margin-bottom: 15px; }
        .auth-tab { flex: 1; padding: 10px; background: #120303; border: 1px solid #591c1c; color: #fff; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 13px; }
        .auth-tab.active { background: #ff3838; color: #fff; }

        .forgot-link { display: block; text-align: right; color: #ff6b6b; font-size: 13px; margin-top: 5px; cursor: pointer; text-decoration: underline; }

        .game-grid { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; margin-bottom: 25px; }
        .game-card { background: #220808; border: 2px solid #591c1c; border-radius: 12px; padding: 15px; width: 105px; cursor: pointer; transition: 0.3s; }
        .game-card:hover, .game-card.active { border-color: #ff3838; transform: translateY(-5px); box-shadow: 0 5px 15px rgba(255, 56, 56, 0.4); }
        .game-card img { width: 100%; border-radius: 8px; }
        .game-card p { margin-top: 8px; font-weight: bold; font-size: 14px; }

        .form-container { background: #220808; max-width: 450px; margin: 0 auto; padding: 25px; border-radius: 15px; display: none; text-align: left; border: 1px solid #591c1c; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        .form-container.active { display: block; }
        .form-group { margin-bottom: 15px; text-align: left; }
        label { display: block; margin-bottom: 6px; color: #ff6b6b; font-weight: bold; font-size: 14px; }
        input, select { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #591c1c; background: #120303; color: #fff; font-size: 15px; outline: none; }
        input:focus, select:focus { border-color: #ff3838; }
        
        .email-box { display: flex; gap: 8px; }
        .btn-email-send { background: #ff6b6b; color: #120303; border: none; padding: 0 12px; border-radius: 6px; font-weight: bold; cursor: pointer; white-space: nowrap; }

        .type-selector { display: flex; gap: 10px; margin-bottom: 15px; }
        .type-btn { flex: 1; padding: 10px; background: #120303; border: 1px solid #591c1c; color: #fff; border-radius: 8px; cursor: pointer; text-align: center; font-size: 13px; font-weight: bold; }
        .type-btn.active { background: #ff3838; color: #fff; border-color: #ff3838; }

        button.btn-submit { width: 100%; padding: 14px; background: linear-gradient(45deg, #ff0000, #b30000); color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 16px; margin-top: 10px; transition: 0.3s; }
        button.btn-submit:hover { opacity: 0.9; transform: scale(1.02); }
        .btn-clear-db { background: transparent; border: 1px dashed #ff3838; color: #ff3838; padding: 8px 15px; border-radius: 6px; margin-top: 30px; cursor: pointer; font-size: 12px; }

        .qr-box { text-align: center; background: #220808; padding: 15px; border-radius: 10px; margin-bottom: 15px; border: 1px solid #591c1c; }
        .qr-box img { width: 220px; height: auto; border-radius: 8px; display: block; margin: 0 auto; }
    </style>
</head>
<body>

    <h1>🔥 phupha game store 🔥</h1>
    <p style="color: #ff6b6b; margin-bottom: 20px; font-weight: bold;">ປອດໄພ 100% | ເຕີມໄວ ທັນໃຈ</p>

    <!-- 📌 ຮູບພາບລາຄາຕິດຢູ່ທາງເທິງ -->
    <div class="top-banners">
        <img src="phupha.png" alt=""
       >
        <img src="file_000000006af881fabbda8825e2f01b68.png" alt="">
    </div>

    <div class="auth-bar">
        <div id="auth-logged-out">
            <div class="auth-tabs">
                <div id="tab-login" class="auth-tab active" onclick="switchAuthMode('login')">ເຂົ້າສູ່ລະບົບ</div>
                <div id="tab-register" class="auth-tab" onclick="switchAuthMode('register')">ສະໝັກສະມາຊິກ</div>
            </div>
            
            <div class="form-group">
                <input type="text" id="auth-username" placeholder="ຊື່ສະມາຊິກ (Username)">
            </div>

            <div id="gmail-group" class="form-group" style="display: none;">
                <div class="email-box">
                    <input type="email" id="auth-gmail" placeholder="Gmail (ເຊັ່ນ: example@gmail.com)">
                    <button id="btn-send-code" class="btn-email-send" style="display: none;" onclick="sendRealEmailCode()">ສົ່ງລະຫັດເຂົ້າ Gmail</button>
                </div>
            </div>

            <div id="code-group" class="form-group" style="display: none;">
                <input type="text" id="auth-email-code" placeholder="ປ້ອນລະຫັດ 6 ຫຼັກ ຈາກກ່ອງຈົດໝາຍ Gmail">
            </div>

            <div class="form-group" style="margin-bottom: 5px;">
                <input type="password" id="auth-password" placeholder="ລະຫັດຜ່ານ (Password)">
                <span id="forgot-btn-link" class="forgot-link" onclick="switchAuthMode('forgot')">🔑 ລືມລະຫັດຜ່ານ?</span>
            </div>

            <button id="auth-btn" class="btn-auth" onclick="handleAuth()">ເຂົ້າສູ່ລະບົບ</button>
        </div>

        <div id="auth-logged-in" class="user-info" style="display: none; width: 100%;">
            <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div>
                    <span>👤 <b id="display-username" style="color: #ff6b6b;"></b></span><br>
                    <span style="font-size: 14px; color: #ff3838;">💰 ຍອດເງິນ: <b id="display-balance">0</b> ກີບ</span>
                </div>
                
                <div>
                    <button class="btn-topup-card-bar" onclick="openCardMoneyForm()">📱 ບັດເຕີມເນັດ</button>
                </div>

                <div style="display: flex; gap: 5px;">
                    <button class="btn-topup-money" onclick="openMoneyForm()">➕ ຕື່ມເງິນ</button>
                    <button class="btn-logout" onclick="logout()">ອອກ</button>
                </div>
            </div>
            <button id="btn-admin" class="btn-admin-panel" onclick="openAdminPanel()">⚙️ ຈັດການລະບົບ (Admin Panel)</button>
        </div>
    </div>

    <!-- ຟອມ Admin ອະນຸມັດຍອດເງິນໃຫ້ລູກຄ້າ -->
    <div id="admin-form" class="form-container">
        <h2 style="margin-bottom: 15px; color: #ff9f43; text-align: center;">⚙️ ແອດມິນ: ບວກຍອດເງິນໃຫ້ລູກຄ້າ</h2>
        
        <div class="form-group">
            <label>ຊື່ລູກຄ້າ (Username):</label>
            <input type="text" id="admin-target-user" placeholder="ປ້ອນຊື່ Username ຂອງລູກຄ້າ">
        </div>

        <div class="form-group">
            <label>ຈຳນວນເງິນທີ່ຕ້ອງການເພີ່ມ:</label>
            <input type="number" id="admin-add-amount" placeholder="ຕົວຢ່າງ: 50000">
        </div>

        <button class="btn-submit" style="background: #ff9f43; color: #120303;" onclick="adminApproveMoney()">✅ ຢືນຢັນບວກຍອດເງິນ</button>
        <button class="btn-clear-db" style="width: 100%; margin-top: 10px;" onclick="closeAdminPanel()">ປິດໜ້າຈໍແອດມິນ</button>
    </div>

    <!-- ຟອມເຕີມເງິນຜ່ານ QR Code ແລະ ແນບ Slip -->
    <div id="money-form" class="form-container">
        <h2 style="margin-bottom: 15px; color: #ff6b6b; text-align: center;">💳 ຕື່ມເງິນ QR (ສະແກນ QR ແລະ ແນບ Slip)</h2>
        <div class="qr-box">
            <img src="qr.png" alt="LaoQR ທະນາຄານ">
            <p style="color: #fff; font-size: 12px; margin-top: 8px;">ສະແກນຜ່ານແອັບທະນາຄານ</p>
        </div>
        
        <div class="form-group">
            <label>ຈຳນວນເງິນທີ່ໂອນ:</label>
            <select id="money-amount">
                <option value="10000">10,000 ກີບ</option>
                <option value="20000">20,000 ກີບ</option>
                <option value="50000">50,000 ກີບ</option>
                <option value="100000">100,000 ກີບ</option>
                <option value="200000">200,000 ກີບ</option>
                <option value="500000">500,000 ກີບ</option>
            </select>
        </div>

        <div class="form-group">
            <label>ແນບຮູບໃບໂອນເງິນ (Slip):</label>
            <input type="file" id="slip-file" accept="image/*" style="padding: 8px;">
        </div>

        <button class="btn-submit" style="background: #ff3838;" onclick="submitMoneyTopup()">📤 ສົ່ງ Slip ໃຫ້ແອດມິນກວດສອບ</button>
        <button class="btn-clear-db" style="width: 100%; margin-top: 10px;" onclick="closeMoneyForm()">ຍົກເລີກ</button>
    </div>

    <!-- ຟອມຕື່ມເງິນເຂົ້າກະເປົາຜ່ານບັດເຕີມເນັດ -->
    <div id="card-money-form" class="form-container">
        <h2 style="margin-bottom: 15px; color: #ff6b6b; text-align: center;">📱 ຕື່ມເງິນເຂົ້າກະເປົາດ້ວຍບັດເຕີມເນັດ</h2>
        
        <div class="form-group">
            <label>ເລືອກເຄືອຂ່າຍ:</label>
            <select id="balance-card-network">
                <option value="Unitel">Unitel</option>
                <option value="Lao Telecom">Lao Telecom (LTC)</option>
            </select>
        </div>

        <div class="form-group">
            <label>ມູນຄ່າບັດ:</label>
            <select id="balance-card-amount">
                <option value="10000">10,000 ກີບ</option>
                <option value="20000">20,000 ກີບ</option>
                <option value="50000">50,000 ກີບ</option>
                <option value="100000">100,000 ກີບ</option>
            </select>
        </div>

        <div class="form-group">
            <label>ລະຫັດບັດ / Serial No.:</label>
            <input type="text" id="balance-card-pin" placeholder="ປ້ອນເລກ Serial ແລະ ລະຫັດບັດ">
        </div>

        <button class="btn-submit" style="background: #ff3838;" onclick="submitCardMoneyTopup()">📤 ສົ່ງຂໍ້ມູນບັດໃຫ້ແອດມິນກວດສອບ</button>
        <button class="btn-clear-db" style="width: 100%; margin-top: 10px;" onclick="closeCardMoneyForm()">ຍົກເລີກ</button>
    </div>

    <div class="game-grid">
        <div class="game-card" onclick="selectGame('Free Fire')">
            <img src="Free Fire.png" alt="Free Fire">
            <p>Free Fire</p>
        </div>
        <div class="game-card" onclick="selectGame('Roblox')">
            <img src="roblox.png" alt="Roblox">
            <p>Roblox</p>
        </div>
        <div class="game-card" onclick="selectGame('MLBB')">
            <img src="mlbb.png" alt="MLBB">
            <p>MLBB</p>
        </div>
    </div>

    <div id="topup-form" class="form-container">
        <h2 id="selected-game-title" style="margin-bottom: 20px; color: #ff3838; text-align: center;"></h2>

        <div class="form-group">
            <label id="id-label">Roblox Username:</label>
            <input type="text" id="user-id" placeholder="ກະລຸນາປ້ອນຊື່ Roblox">
        </div>

        <div id="password-group" class="form-group" style="display: none;">
            <label>Password (ລະຫັດຜ່ານ ID Roblox):</label>
            <input type="password" id="user-pass" placeholder="ກະລຸນາປ້ອນລະຫັດຜ່ານ Roblox">
        </div>

        <div id="ff-type-group" class="form-group" style="display: none;">
            <label>ເລືອກປະເພດ:</label>
            <div class="type-selector">
                <div id="btn-diamonds" class="type-btn active" onclick="switchFFType('diamonds')">💎 ເພັດ (Diamonds)</div>
                <div id="btn-growth" class="type-btn" onclick="switchFFType('growth')">🎁 ແພັກເຕີບໂຕ</div>
            </div>
        </div>

        <div class="form-group">
            <label>ເລືອກແພັກເກັດ:</label>
            <select id="package"></select>
        </div>

        <button class="btn-submit" onclick="submitTopup()">ດໍາເນີນການຊໍາລະເງິນ</button>
    </div>

    <button class="btn-clear-db" onclick="clearDataCache()">🧹 ລ້າງຂໍ້ມູນເກົ່າທີ່ຄ້າງ (Reset Cache)</button>

    <script>
        let currentGame = '';
        let authMode = 'login'; 
        let currentUser = null;
        let generatedCode = null;

        let usersDB = JSON.parse(localStorage.getItem('phupha_users')) || [];

        function switchAuthMode(mode) {
            authMode = mode;
            const tabLogin = document.getElementById('tab-login');
            const tabRegister = document.getElementById('tab-register');
            const authBtn = document.getElementById('auth-btn');
            const gmailGroup = document.getElementById('gmail-group');
            const codeGroup = document.getElementById('code-group');
            const btnSendCode = document.getElementById('btn-send-code');
            const passInput = document.getElementById('auth-password');
            const forgotLink = document.getElementById('forgot-btn-link');

            if(mode === 'login') {
                tabLogin.classList.add('active');
                tabRegister.classList.remove('active');
                authBtn.innerText = 'ເຂົ້າສູ່ລະບົບ';
                gmailGroup.style.display = 'none';
                codeGroup.style.display = 'none';
                btnSendCode.style.display = 'none';
                passInput.placeholder = 'ລະຫັດຜ່ານ (Password)';
                forgotLink.style.display = 'block';
            } else if(mode === 'register') {
                tabRegister.classList.add('active');
                tabLogin.classList.remove('active');
                authBtn.innerText = 'ຢືນຢັນການສະໝັກສະມາຊິກ';
                gmailGroup.style.display = 'block';
                codeGroup.style.display = 'none';
                btnSendCode.style.display = 'none';
                passInput.placeholder = 'ຕັ້ງລະຫັດຜ່ານ (Password)';
                forgotLink.style.display = 'none';
            } else if(mode === 'forgot') {
                tabLogin.classList.remove('active');
                tabRegister.classList.remove('active');
                authBtn.innerText = '🔄 ຢືນຢັນປ່ຽນລະຫັດຜ່ານໃໝ່';
                gmailGroup.style.display = 'block';
                codeGroup.style.display = 'block';
                btnSendCode.style.display = 'block';
                passInput.placeholder = 'ຕັ້ງລະຫັດຜ່ານໃໝ່ (New Password)';
                forgotLink.style.display = 'none';
            }
        }

        function isValidGmail(gmail) {
            return /^[a-zA-Z0-9._%+-]+@gmail\.com$/.test(gmail);
        }

        function sendRealEmailCode() {
            const gmailIn = document.getElementById('auth-gmail').value.trim();
            const userIn = document.getElementById('auth-username').value.trim();

            if(!isValidGmail(gmailIn)) {
                alert('❌ ກະລຸນາປ້ອນ Gmail ໃຫ້ຖືກຕ້ອງ! (@gmail.com)');
                return;
            }

            const isUserExist = usersDB.some(u => 
                u.username && u.username.toLowerCase() === userIn.toLowerCase() && 
                u.gmail && u.gmail.toLowerCase() === gmailIn.toLowerCase()
            );

            if(!isUserExist) {
                alert('❌ ບໍ່ພົບ Gmail ແລະ ຊື່ສະມາຊິກນີ້ໃນລະບົບ!');
                return;
            }

            generatedCode = Math.floor(100000 + Math.random() * 900000).toString();

            emailjs.send('service_ud4vfuy', 'template_8zrxyba', {
                to_email: gmailIn,
                otp_code: generatedCode
            }).then(function() {
                alert(`📧 ສົ່ງລະຫັດ OTP ໄປທີ່ກ່ອງຈົດໝາຍ Gmail: ${gmailIn} ຮຽບຮ້ອຍແລ້ວ!`);
            }, function(error) {
                alert('❌ ສົ່ງອີເມວບໍ່ສໍາເລັດ: ' + JSON.stringify(error));
            });
        }

        function handleAuth() {
            const userIn = document.getElementById('auth-username').value.trim();
            const passIn = document.getElementById('auth-password').value.trim();

            if(!userIn || !passIn) {
                alert('❌ ກະລຸນາປ້ອນຂໍ້ມູນໃຫ້ຄົບຖ້ວນ!');
                return;
            }

            if(authMode === 'register') {
                const gmailIn = document.getElementById('auth-gmail').value.trim();

                if(!isValidGmail(gmailIn)) {
                    alert('❌ ກະລຸນາປ້ອນ Gmail ທີ່ໃຊ້ໄດ້ຈິງ! (ຕ້ອງເປັນ @gmail.com)');
                    return;
                }

                const isUsernameExist = usersDB.some(u => u.username && u.username.toLowerCase() === userIn.toLowerCase());
                if(isUsernameExist) {
                    alert('❌ ຊື່ສະມາຊິກນີ້ມີຜູ້ໃຊ້ແລ້ວ!');
                    return;
                }

                const isGmailExist = usersDB.some(u => u.gmail && u.gmail.toLowerCase() === gmailIn.toLowerCase());
                if(isGmailExist) {
                    alert('❌ Gmail ນี้ຖືກນໍາໃຊ້ສະໝັກແລ້ວ!');
                    return;
                }

                usersDB.push({ username: userIn, password: passIn, gmail: gmailIn, balance: 0 });
                localStorage.setItem('phupha_users', JSON.stringify(usersDB));
